{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "ConstactList",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "Constact List Server"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "auth orepation"
    },
    {
      "name": "Contacts",
      "description": "Contacts orepation"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "sumary": "User register",
        "operationId": "UserRegister",
        "description": "User Registration",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "description": "Enter your Name",
                    "type": "string",
                    "example": "Niko Weg"
                  },
                  "email": {
                    "description": "Enter your Email",
                    "type": "string",
                    "example": "qwerty2025@gmail.com"
                  },
                  "password": {
                    "description": "Enter your Password",
                    "type": "string",
                    "example": "qwrrtyu2025"
                  }
                }
              }
            }
          }
        },
        "response": {
          "201": {
            "description": "Success register",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Success register"
                    },
                    "data": {
                      "type": "string",
                      "exemple": "Hello World"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "sumary": "User register",
        "operationId": "UserRegister",
        "description": "User Registration",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "description": "Enter your Name",
                    "type": "string",
                    "example": "Niko Weg"
                  },
                  "email": {
                    "description": "Enter your Email",
                    "type": "string",
                    "example": "qwerty2025@gmail.com"
                  },
                  "password": {
                    "description": "Enter your Password",
                    "type": "string",
                    "example": "qwrrtyu2025"
                  }
                }
              }
            }
          }
        },
        "response": {
          "201": {
            "description": "Success register",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Success register"
                    },
                    "data": {
                      "type": "string",
                      "exemple": "Hello World"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}